{
  "manifest_version": 3,
  "name": "AI Image Detection",
  "description": "Flags AI-generated images on social media using an on-device ML model.",
  "version": "1.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },

  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "*://*.x.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.reddit.com/*"
  ],

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.reddit.com/*"
      ],
      "js": ["content/overlay.js"],
      "css": ["content/overlay.css"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["models/*", "images/*"],
      "matches": [
        "*://*.x.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.reddit.com/*"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}